{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing authentication identity and system role.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["RECRUITER", "CANDIDATE"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "Job": {
      "title": "Job",
      "description": "Job posting with structured requirements, compensation, application settings, lifecycle status, and recruiter ownership.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "recruiterId": { "type": "string", "maxLength": 128 },
        "recruiterEmail": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "department": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "workMode": { "type": "string", "enum": ["Remote", "Hybrid", "On-site"] },
        "employmentType": { "type": "string", "enum": ["Full-time", "Part-time", "Contract", "Internship"] },
        "summary": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 20000 },
        "responsibilities": { "type": "array" },
        "requiredSkills": { "type": "array" },
        "preferredSkills": { "type": "array" },
        "requiredEducation": { "type": "array" },
        "preferredEducation": { "type": "array" },
        "requiredExperience": { "type": "string", "maxLength": 200 },
        "preferredExperience": { "type": "string", "maxLength": 200 },
        "requiredCertifications": { "type": "array" },
        "preferredCertifications": { "type": "array" },
        "salaryMin": { "type": "number" },
        "salaryMax": { "type": "number" },
        "salaryCurrency": { "type": "string", "maxLength": 10 },
        "salaryRange": { "type": "string", "maxLength": 100 },
        "applicationDeadline": { "type": "string" },
        "maxApplications": { "type": "number" },
        "applicationEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "status": { "type": "string", "enum": ["draft", "published", "closed", "DRAFT", "ACTIVE", "CLOSED", "active"] },
        "applicationsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "publishedAt": { "type": "string" },
        "closedAt": { "type": "string" }
      },
      "required": ["title", "company", "recruiterId", "status"]
    },
    "Application": {
      "title": "Application",
      "description": "Job application submitted by candidate with extracted resume text.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "string", "maxLength": 128 },
        "candidateId": { "type": "string", "maxLength": 128 },
        "recruiterId": { "type": "string", "maxLength": 128 },
        "candidateName": { "type": "string", "maxLength": 200 },
        "candidateEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "candidatePhone": { "type": "string", "maxLength": 50 },
        "education": { "type": "object" },
        "experience": { "type": "object" },
        "skills": { "type": "array" },
        "projects": { "type": "array" },
        "certifications": { "type": "array" },
        "coverLetter": { "type": "string", "maxLength": 10000 },
        "resumeText": { "type": "string", "maxLength": 50000 },
        "resumeFileName": { "type": "string", "maxLength": 300 },
        "aiProfile": { "type": "object" },
        "aiAnalysisStatus": { "type": "string" },
        "aiMatchAnalysis": { "type": "object" },
        "aiMatchStatus": { "type": "string" },
        "matchScore": { "type": "number" },
        "matchStrength": { "type": "string" },
        "aiRecommendation": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "under_review", "shortlisted", "rejected", "hired", "APPLIED", "UNDER_REVIEW", "SHORTLISTED", "REJECTED", "HIRED"] },
        "appliedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["jobId", "recruiterId", "candidateName", "resumeText", "status"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Candidate profile record for applicants.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "education": { "type": "object" },
        "experience": { "type": "object" },
        "skills": { "type": "array" },
        "projects": { "type": "array" },
        "certifications": { "type": "array" },
        "resumeText": { "type": "string", "maxLength": 50000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles and role configurations."
    },
    "/jobs/{jobId}": {
      "schema": "#/entities/Job",
      "description": "Job positions created by recruiters."
    },
    "/applications/{applicationId}": {
      "schema": "#/entities/Application",
      "description": "Candidate applications linked to specific job openings."
    },
    "/candidates/{candidateId}": {
      "schema": "#/entities/Candidate",
      "description": "Candidate profiles."
    }
  }
}
